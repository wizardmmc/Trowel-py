{
  "name": "trowel-desktop",
  "productName": "Trowel",
  "private": true,
  "version": "0.2.0",
  "main": "desktop-dist/desktop/main.js",
  "type": "module",
  "scripts": {
    "check:agent-boundaries": "bun scripts/check-agent-boundaries.mjs",
    "check:module-comments": "bun scripts/check-module-comments.mjs",
    "check:ui-contracts": "bun scripts/check-ui-contracts.mjs",
    "brand:build": "node scripts/generate-brand-assets.mjs",
    "dev": "vite",
    "dev:agent-statistics": "vite --open /agent-statistics-preview.html",
    "dev:memory-statistics": "vite --open /memory-statistics-preview.html",
    "dev:runtime-statistics": "vite --open /runtime-statistics-preview.html",
    "dev:call-statistics": "vite --open /call-statistics-preview.html",
    "desktop:build": "node scripts/clean-desktop-output.mjs && bun run brand:build && tsc -p desktop/tsconfig.json && bun build desktop/preload.ts --target=node --format=cjs --external electron --outfile=desktop-dist/desktop/preload.js && node desktop/copy-assets.mjs",
    "desktop:dev": "bun run desktop:build && node desktop/dev.mjs",
    "desktop:dev:observe": "bun run desktop:build && node desktop/dev.mjs --observe",
    "desktop:dev:isolated": "bun run desktop:build && node desktop/dev.mjs --isolated",
    "desktop:data-migration:plan": "cd .. && .venv/bin/python -m trowel_py.desktop.data_migration --config config.toml",
    "desktop:data-migration:apply": "cd .. && .venv/bin/python -m trowel_py.desktop.data_migration --config config.toml --apply",
    "desktop:smoke": "bun run desktop:build && node desktop/dev.mjs --smoke",
    "desktop:settings-smoke": "bun run desktop:build && node desktop/dev.mjs --settings-smoke",
    "desktop:diagnostic-smoke": "bun run desktop:build && node desktop/dev.mjs --diagnostic-smoke",
    "desktop:single-instance-smoke": "bun run desktop:build && node desktop/dev.mjs --single-instance-smoke",
    "desktop:sidecar-hang-smoke": "bun run desktop:build && node desktop/dev.mjs --sidecar-hang-smoke",
    "desktop:renderer-crash-smoke": "bun run desktop:build && node desktop/dev.mjs --renderer-crash-smoke",
    "desktop:shared-service-smoke": "bun run desktop:build && node desktop/dev.mjs --shared-service-smoke",
    "desktop:agent-transport-smoke": "bun run desktop:build && node desktop/dev.mjs --agent-transport-smoke",
    "sidecar:build": "node scripts/build-sidecar.mjs",
    "release:finalize-mac": "node scripts/finalize-macos-release.mjs",
    "release:metadata": "node scripts/generate-release-metadata.mjs",
    "release:source-check": "node scripts/release-source.cjs",
    "smoke:packaged-mac": "node scripts/smoke-packaged-app.mjs",
    "smoke:packaged-settings-mac": "node scripts/smoke-packaged-app.mjs --settings",
    "smoke:packaged-default-paths-mac": "node scripts/smoke-packaged-app.mjs --default-paths",
    "smoke:packaged-residency-mac": "node scripts/smoke-packaged-app.mjs --residency",
    "smoke:packaged-renderer-crash-mac": "node scripts/smoke-packaged-app.mjs --renderer-crash",
    "smoke:packaged-agent-transport-mac": "node scripts/smoke-packaged-app.mjs --agent-transport",
    "smoke:dmg-install-mac": "node scripts/smoke-dmg-install.mjs",
    "package:mac": "node scripts/guard-packaged-output.mjs && bun run build && bun run sidecar:build && node scripts/guard-packaged-output.mjs && electron-forge package --platform=darwin --arch=arm64",
    "make:mac": "node scripts/guard-packaged-output.mjs && bun run build && bun run sidecar:build && node scripts/guard-packaged-output.mjs && electron-forge make --platform=darwin --arch=arm64 && bun run release:finalize-mac && bun run release:metadata",
    "make:mac:community": "bun run release:source-check && TROWEL_RELEASE_SOURCE=1 bun run make:mac",
    "perf:large-turn": "vite --host 127.0.0.1 --port 4174",
    "build": "tsc -b && vite build && bun run desktop:build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "bun run check:agent-boundaries && bun run check:module-comments && bun run check:ui-contracts && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.3.7",
    "diff": "^9.0.0",
    "echarts": "^6.1.0",
    "framer-motion": "^12.40.0",
    "katex": "^0.17.0",
    "lxgw-wenkai-webfont": "^1.7.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "postcss": "8.5.18",
    "tar": "7.5.22",
    "tmp": "0.2.7",
    "undici": "7.28.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/diff": "^8.0.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "43.2.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  }
}
