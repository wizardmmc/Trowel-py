# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
*.egg-info/

# ── Build / packaging ───────────────────────────────────────────────────────
build/
dist/

# ── Secrets & local config (carries API keys / machine paths) ───────────────
config.toml
CLAUDE.local.md
CLAUDE-archived.md
Learn.md

# ── Local runtime data (DBs, logs, memory, output) ──────────────────────────
*.db
*.db-shm
*.db-wal
logs/
output/
/memory

# ── Test fixtures that are LOCAL real recordings ────────────────────────────
# These are captures from THIS machine's real cc/codex/GLM sessions (and the
# live GLM quota probe) — they carry personal usage/session data, not shared
# test inputs, so they stay local. Shared protocol/benchmark fixtures in
# tests/codex_host|cc_host|memory/fixtures (model-list, schema-baseline,
# eval-queries.yaml, …) are NOT ignored — tests depend on them.
tests/quota/fixtures/
tests/model_os/fixtures/
# real cc init recording — carries local /Users/<home> paths (PII):
tests/fixtures/cc-init-291.json

# ── Spikes (scratch experiments, gitignored) ────────────────────────────────
spikes/

# ── Frontend / tooling ──────────────────────────────────────────────────────
trowel_py/static/
web/desktop-dist/
web/.release/
web/out/
.vite/
.playwright-mcp/
.playwright-cli/
.gstack/
**/.moon/cache/
.moon/quality-run.lock
.quality-runs/

# ── Editor / OS ─────────────────────────────────────────────────────────────
.claude/
.DS_Store

# ── 共享项目文档与私人规划
# docs 默认私有，只版本化下列已审查的项目上下文。
# Git 要求每层父目录都显式取消忽略。
docs/*
!docs/foundation/
docs/foundation/*
!docs/foundation/prd.md
!docs/foundation/development.md
!docs/foundation/front-end-design-language.md
!docs/reference/
docs/reference/*
!docs/reference/agent-runtime.md
!docs/reference/memory-runtime.md
progress.txt
tmp/
*.log
